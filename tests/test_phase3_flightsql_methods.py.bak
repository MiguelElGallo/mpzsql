class TestPhase3DoExchange:
    """Test Phase 3 do_exchange method for bidirectional streaming."""

    def test_do_exchange_basic_streaming(self, server):
        """Test basic do_exchange bidirectional streaming."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Create descriptor for bidirectional streaming
        descriptor = pf.FlightDescriptor.for_command(b"streaming_command")
        
        # Create mock reader and writer
        reader = Mock(spec=pf.MetadataRecordBatchReader)
        writer = Mock(spec=pf.MetadataRecordBatchWriter)
        
        # Mock reader to yield test batches
        test_batches = [
            pa.record_batch({"query": ["SELECT * FROM test"]}),
            pa.record_batch({"data": [1, 2, 3]})
        ]
        reader.__iter__ = Mock(return_value=iter(test_batches))
        
        # Test do_exchange implementation
        if hasattr(server, 'do_exchange'):
            # Call do_exchange with correct signature
            server.do_exchange(context, descriptor, reader, writer)
            
            # Verify writer was called (bidirectional communication occurred)
            assert writer.write_batch.called or hasattr(writer, 'write_batch')
        else:
            # Placeholder test for when do_exchange is not yet implemented
            assert True  # Phase 3 method may not be implemented yet

    def test_do_exchange_computation_offloading(self, server):
        """Test do_exchange for computation offloading scenarios."""
        context = Mock(spec=pf.ServerCallContext)
        
        def computation_request():
            # Client sends computation request with data
            compute_batch = pa.record_batch({
                "operation": ["aggregate"],
                "column": ["sales"],
                "function": ["sum"]
            })
            yield pa.flight.FlightData.create_from_batch(compute_batch)
            
            # Client sends data for computation
            data_batch = pa.record_batch({
                "sales": [100, 200, 300, 400],
                "region": ["north", "south", "east", "west"]
            })
            yield pa.flight.FlightData.create_from_batch(data_batch)
        
        request_iterator = computation_request()
        
        # Mock server-side computation
        server.backend.execute_computation.return_value = pa.record_batch({
            "result": [1000],  # Sum of sales
            "computation_id": ["comp_123"]
        })
        
        if hasattr(server, 'do_exchange'):
            response_stream = server.do_exchange(context, request_iterator)
            responses = list(response_stream)
            assert len(responses) >= 1
        else:
            assert True

    def test_do_exchange_streaming_aggregation(self, server):
        """Test do_exchange for streaming data aggregation."""
        context = Mock(spec=pf.ServerCallContext)
        
        def streaming_data():
            # Simulate streaming data chunks
            for i in range(5):
                batch = pa.record_batch({
                    "timestamp": [time.time() + i],
                    "value": [i * 10],
                    "chunk_id": [i]
                })
                yield pa.flight.FlightData.create_from_batch(batch)
        
        request_iterator = streaming_data()
        
        # Mock streaming aggregation
        server.backend.process_streaming_aggregation.return_value = iter([
            pa.record_batch({"running_sum": [0]}),
            pa.record_batch({"running_sum": [10]}),
            pa.record_batch({"running_sum": [30]}),
            pa.record_batch({"running_sum": [60]}),
            pa.record_batch({"running_sum": [100]})
        ])
        
        if hasattr(server, 'do_exchange'):
            response_stream = server.do_exchange(context, request_iterator)
            responses = list(response_stream)
            assert len(responses) >= 1
        else:
            assert True

    def test_do_exchange_error_handling(self, server):
        """Test do_exchange error handling and recovery."""
        context = Mock(spec=pf.ServerCallContext)
        
        def error_request():
            # Send malformed data to trigger error handling
            yield pa.flight.FlightData.create_from_batch(
                pa.record_batch({"invalid": ["data"]})
            )
        
        request_iterator = error_request()
        
        # Mock error in processing
        server.backend.process_streaming_aggregation.side_effect = ValueError("Processing error")
        
        if hasattr(server, 'do_exchange'):
            with pytest.raises((ValueError, NotImplementedError)):
                response_stream = server.do_exchange(context, request_iterator)
                list(response_stream)
        else:
            assert True

    def test_do_exchange_memory_management(self, server):
        """Test do_exchange memory-efficient processing."""
        context = Mock(spec=pf.ServerCallContext)
        
        def large_data_stream():
            # Simulate large data stream processing
            for chunk in range(10):
                large_batch = pa.record_batch({
                    "chunk_id": [chunk],
                    "data": [f"large_data_chunk_{chunk}"] * 1000
                })
                yield pa.flight.FlightData.create_from_batch(large_batch)
        
        request_iterator = large_data_stream()
        
        # Mock memory-efficient processing
        server.backend.process_large_stream.return_value = iter([
            pa.record_batch({"processed_chunks": [i]}) for i in range(10)
        ])
        
        if hasattr(server, 'do_exchange'):
            response_stream = server.do_exchange(context, request_iterator)
            responses = list(response_stream)
            # Should handle large data without memory issues
            assert len(responses) >= 1
        else:
            assert True


class TestPhase3PollFlightInfo:
    """Test Phase 3 poll_flight_info method for long-running query monitoring."""

    def test_poll_flight_info_query_status(self, server):
        """Test polling status of long-running queries."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Create flight descriptor for long-running query
        any_msg = any_pb2.Any()
        any_msg.type_url = FlightSQLProtobuf.COMMAND_STATEMENT_QUERY_TYPE_URL
        
        long_query = "SELECT * FROM large_table ORDER BY complex_calculation(column)"
        query_encoded = long_query.encode("utf-8")
        any_msg.value = bytes([0x0A]) + bytes([len(query_encoded)]) + query_encoded
        
        descriptor = pf.FlightDescriptor.for_command(any_msg.SerializeToString())
        
        # Mock long-running query status
        server.backend.get_query_status.return_value = {
            "status": "running",
            "progress": 0.75,
            "estimated_completion": time.time() + 30,
            "rows_processed": 750000,
            "total_rows": 1000000
        }
        
        if hasattr(server, 'poll_flight_info'):
            poll_info = server.poll_flight_info(context, descriptor)
            
            # Verify poll info structure
            assert hasattr(poll_info, 'info')
            assert hasattr(poll_info, 'flight_descriptor')
            assert hasattr(poll_info, 'progress')
        else:
            # Test placeholder for unimplemented method
            with pytest.raises(NotImplementedError):
                server.poll_flight_info(context, descriptor)

    def test_poll_flight_info_completed_query(self, server):
        """Test polling completed query status."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Create descriptor for completed query
        any_msg = any_pb2.Any()
        any_msg.type_url = FlightSQLProtobuf.COMMAND_STATEMENT_QUERY_TYPE_URL
        any_msg.value = b"SELECT COUNT(*) FROM users"
        
        descriptor = pf.FlightDescriptor.for_command(any_msg.SerializeToString())
        
        # Mock completed query
        server.backend.get_query_status.return_value = {
            "status": "completed",
            "progress": 1.0,
            "result_available": True,
            "total_rows": 1000
        }
        
        if hasattr(server, 'poll_flight_info'):
            poll_info = server.poll_flight_info(context, descriptor)
            assert poll_info.progress >= 1.0
        else:
            with pytest.raises(NotImplementedError):
                server.poll_flight_info(context, descriptor)

    def test_poll_flight_info_failed_query(self, server):
        """Test polling failed query status."""
        context = Mock(spec=pf.ServerCallContext)
        
        descriptor = pf.FlightDescriptor.for_command(b"INVALID SQL QUERY")
        
        # Mock failed query
        server.backend.get_query_status.return_value = {
            "status": "failed",
            "error": "Syntax error in SQL query",
            "progress": 0.3  # Failed partway through
        }
        
        if hasattr(server, 'poll_flight_info'):
            poll_info = server.poll_flight_info(context, descriptor)
            # Should return error information
            assert hasattr(poll_info, 'info')
        else:
            with pytest.raises(NotImplementedError):
                server.poll_flight_info(context, descriptor)

    def test_poll_flight_info_timeout_handling(self, server):
        """Test poll_flight_info timeout and long-polling behavior."""
        context = Mock(spec=pf.ServerCallContext)
        
        descriptor = pf.FlightDescriptor.for_command(b"SELECT * FROM slow_table")
        
        # Mock query with varying status
        status_sequence = [
            {"status": "queued", "progress": 0.0},
            {"status": "running", "progress": 0.2},
            {"status": "running", "progress": 0.5},
            {"status": "completed", "progress": 1.0}
        ]
        
        server.backend.get_query_status.side_effect = status_sequence
        
        if hasattr(server, 'poll_flight_info'):
            for expected_status in status_sequence:
                poll_info = server.poll_flight_info(context, descriptor)
                # Should reflect current query status
                assert isinstance(poll_info, object)
        else:
            with pytest.raises(NotImplementedError):
                server.poll_flight_info(context, descriptor)

    def test_poll_flight_info_expiration(self, server):
        """Test poll_flight_info with query expiration."""
        context = Mock(spec=pf.ServerCallContext)
        
        descriptor = pf.FlightDescriptor.for_command(b"SELECT * FROM temp_view")
        
        # Mock expired query
        server.backend.get_query_status.return_value = {
            "status": "expired",
            "expiration_time": time.time() - 3600,  # Expired 1 hour ago
            "message": "Query result expired and was cleaned up"
        }
        
        if hasattr(server, 'poll_flight_info'):
            poll_info = server.poll_flight_info(context, descriptor)
            # Should indicate expiration
            assert hasattr(poll_info, 'expiration_time')
        else:
            with pytest.raises(NotImplementedError):
                server.poll_flight_info(context, descriptor)


class TestPhase3CancelFlightInfo:
    """Test Phase 3 query cancellation and resource cleanup."""

    def test_cancel_running_query(self, server):
        """Test cancelling a running query."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Create cancel action
        cancel_action = pf.Action("CancelFlightInfo", pa.py_buffer(b"query_id_123"))
        
        # Mock successful cancellation
        server.backend.cancel_query.return_value = True
        
        results = list(server.do_action(context, cancel_action))
        assert len(results) == 1
        
        # Verify cancellation was processed
        result_data = results[0].body.to_pybytes()
        assert result_data == b"" or b"cancelled" in result_data.lower()

    def test_cancel_nonexistent_query(self, server):
        """Test cancelling a non-existent query."""
        context = Mock(spec=pf.ServerCallContext)
        
        cancel_action = pf.Action("CancelFlightInfo", pa.py_buffer(b"invalid_query_id"))
        
        # Mock query not found
        server.backend.cancel_query.return_value = False
        
        results = list(server.do_action(context, cancel_action))
        assert len(results) == 1

    def test_cancel_completed_query(self, server):
        """Test cancelling an already completed query."""
        context = Mock(spec=pf.ServerCallContext)
        
        cancel_action = pf.Action("CancelFlightInfo", pa.py_buffer(b"completed_query"))
        
        # Mock query already completed
        server.backend.cancel_query.side_effect = ValueError("Query already completed")
        
        # Should handle gracefully
        results = list(server.do_action(context, cancel_action))
        assert len(results) == 1

    def test_bulk_query_cancellation(self, server):
        """Test cancelling multiple queries at once."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Cancel multiple queries
        query_ids = ["query_1", "query_2", "query_3"]
        bulk_cancel_data = ",".join(query_ids).encode("utf-8")
        cancel_action = pf.Action("CancelMultipleQueries", pa.py_buffer(bulk_cancel_data))
        
        # Mock bulk cancellation
        server.backend.cancel_multiple_queries.return_value = {
            "cancelled": ["query_1", "query_3"],
            "not_found": ["query_2"]
        }
        
        results = list(server.do_action(context, cancel_action))
        assert len(results) == 1


class TestPhase3AdvancedSessionManagement:
    """Test Phase 3 advanced session management and lifecycle."""

    def test_session_resource_tracking(self, server):
        """Test tracking of session resources."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Simulate session with multiple resources
        session_action = pf.Action("CreateSession", pa.py_buffer(b"session_config"))
        
        results = list(server.do_action(context, session_action))
        assert len(results) == 1
        
        # Verify session tracking
        assert len(server.open_sessions) >= 0  # May already have sessions

    def test_session_timeout_handling(self, server):
        """Test session timeout and automatic cleanup."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Create session with timeout
        timeout_action = pf.Action("SetSessionTimeout", pa.py_buffer(b"timeout:30"))
        
        results = list(server.do_action(context, timeout_action))
        assert len(results) == 1
        
        # Mock expired session cleanup
        server.backend.cleanup_expired_sessions.return_value = 2
        
        cleanup_action = pf.Action("CleanupExpiredSessions", pa.py_buffer(b""))
        results = list(server.do_action(context, cleanup_action))
        assert len(results) == 1

    def test_session_state_persistence(self, server):
        """Test session state persistence and recovery."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Set session state
        state_action = pf.Action("SetSessionState", pa.py_buffer(b"key:value,setting:enabled"))
        
        results = list(server.do_action(context, state_action))
        assert len(results) == 1
        
        # Retrieve session state
        get_state_action = pf.Action("GetSessionState", pa.py_buffer(b""))
        
        results = list(server.do_action(context, get_state_action))
        assert len(results) == 1

    def test_concurrent_session_management(self, server):
        """Test handling multiple concurrent sessions."""
        contexts = [Mock(spec=pf.ServerCallContext) for _ in range(5)]
        
        # Create multiple sessions concurrently
        def create_session(ctx, session_id):
            action = pf.Action("CreateSession", pa.py_buffer(f"session_{session_id}".encode()))
            return list(server.do_action(ctx, action))
        
        # Simulate concurrent session creation
        sessions = []
        for i, ctx in enumerate(contexts):
            session_results = create_session(ctx, i)
            sessions.append(session_results)
        
        assert len(sessions) == 5
        assert all(len(session) == 1 for session in sessions)


class TestPhase3StreamOptimization:
    """Test Phase 3 streaming optimizations and memory management."""

    def test_large_dataset_streaming(self, server):
        """Test efficient streaming of large datasets."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Create ticket for large dataset
        large_query = "SELECT * FROM huge_table"
        any_msg = any_pb2.Any()
        any_msg.type_url = FlightSQLProtobuf.COMMAND_STATEMENT_QUERY_TYPE_URL
        query_encoded = large_query.encode("utf-8")
        any_msg.value = bytes([0x0A]) + bytes([len(query_encoded)]) + query_encoded
        
        ticket = pf.Ticket(any_msg.SerializeToString())
        
        # Mock large dataset with chunked response
        large_table = _create_large_test_table(100000)  # 100K rows
        server.backend.execute_query.return_value = large_table
        
        stream = server.do_get(context, ticket)
        assert isinstance(stream, pf.FlightDataStream)

    def test_streaming_memory_efficiency(self, server):
        """Test memory-efficient streaming without loading entire dataset."""
        context = Mock(spec=pf.ServerCallContext)
        
        ticket = pf.Ticket(b"streaming_query")
        
        # Mock chunked data provider
        def chunked_data_generator():
            for i in range(10):
                yield pa.record_batch({
                    "chunk": [i],
                    "data": [f"chunk_{i}_data"] * 1000
                })
        
        server.backend.get_chunked_data.return_value = chunked_data_generator()
        
        # Verify streaming works without memory issues
        stream = server.do_get(context, ticket)
        assert isinstance(stream, pf.FlightDataStream)

    def test_stream_compression(self, server):
        """Test stream compression for bandwidth optimization."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Create compressed data ticket
        ticket = pf.Ticket(b"compressed_query")
        
        # Mock compressed data
        compressed_table = pa.table({
            "id": list(range(1000)),
            "repeated_data": ["same_value"] * 1000  # Highly compressible
        })
        server.backend.execute_query.return_value = compressed_table
        
        stream = server.do_get(context, ticket)
        assert isinstance(stream, pf.FlightDataStream)

    def test_parallel_stream_processing(self, server):
        """Test parallel processing of multiple streams."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Create multiple parallel queries
        queries = [f"SELECT * FROM partition_{i}" for i in range(5)]
        tickets = []
        
        for query in queries:
            any_msg = any_pb2.Any()
            any_msg.type_url = FlightSQLProtobuf.COMMAND_STATEMENT_QUERY_TYPE_URL
            query_encoded = query.encode("utf-8")
            any_msg.value = bytes([0x0A]) + bytes([len(query_encoded)]) + query_encoded
            tickets.append(pf.Ticket(any_msg.SerializeToString()))
        
        # Mock parallel execution
        server.backend.execute_query.return_value = pa.table({
            "partition_id": [1, 2, 3],
            "data": ["a", "b", "c"]
        })
        
        # Test concurrent stream handling
        streams = []
        for ticket in tickets:
            stream = server.do_get(context, ticket)
            streams.append(stream)
        
        assert len(streams) == 5
        assert all(isinstance(s, pf.FlightDataStream) for s in streams)


class TestPhase3ErrorRecovery:
    """Test Phase 3 error recovery and resilience mechanisms."""

    def test_connection_recovery(self, server):
        """Test recovery from connection failures."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Simulate connection failure
        server.backend.execute_query.side_effect = ConnectionError("Database connection lost")
        
        ticket = pf.Ticket(b"test_query")
        
        # Should handle connection errors gracefully
        with pytest.raises(ConnectionError):
            stream = server.do_get(context, ticket)

    def test_query_retry_mechanism(self, server):
        """Test automatic query retry on transient failures."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Mock transient failure followed by success
        call_count = 0
        def mock_execute_with_retry(*args, **kwargs):
            nonlocal call_count
            call_count += 1
            if call_count == 1:
                raise ConnectionError("Transient failure")
            return pa.table({"id": [1], "name": ["success"]})
        
        server.backend.execute_query.side_effect = mock_execute_with_retry
        
        ticket = pf.Ticket(b"retry_query")
        
        # Should handle transient failures with retry
        if hasattr(server, '_retry_on_failure'):
            stream = server.do_get(context, ticket)
            assert isinstance(stream, pf.FlightDataStream)
        else:
            # Without retry mechanism, should still fail
            with pytest.raises(ConnectionError):
                stream = server.do_get(context, ticket)

    def test_partial_result_recovery(self, server):
        """Test recovery and continuation from partial results."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Mock partial result scenario
        server.backend.get_partial_results.return_value = {
            "completed_rows": 50000,
            "total_rows": 100000,
            "continuation_token": "token_12345"
        }
        
        resume_action = pf.Action("ResumeQuery", pa.py_buffer(b"token_12345"))
        
        results = list(server.do_action(context, resume_action))
        assert len(results) == 1

    def test_resource_cleanup_on_failure(self, server):
        """Test proper resource cleanup when operations fail."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Simulate failure that requires cleanup
        server.backend.execute_query.side_effect = Exception("Critical failure")
        
        ticket = pf.Ticket(b"failing_query")
        
        try:
            stream = server.do_get(context, ticket)
        except Exception:
            pass
        
        # Verify cleanup was attempted
        cleanup_action = pf.Action("CleanupResources", pa.py_buffer(b""))
        results = list(server.do_action(context, cleanup_action))
        assert len(results) == 1

    def test_circuit_breaker_pattern(self, server):
        """Test circuit breaker pattern for failing backends."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Simulate repeated failures
        server.backend.execute_query.side_effect = Exception("Backend unavailable")
        
        # Multiple failed attempts
        for i in range(5):
            ticket = pf.Ticket(f"query_{i}".encode())
            try:
                stream = server.do_get(context, ticket)
            except Exception:
                pass
        
        # Circuit breaker should be triggered
        status_action = pf.Action("GetCircuitBreakerStatus", pa.py_buffer(b""))
        results = list(server.do_action(context, status_action))
        assert len(results) == 1


class TestPhase3PerformanceOptimization:
    """Test Phase 3 performance optimizations and scalability."""

    def test_connection_pooling(self, server):
        """Test connection pooling for improved performance."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Test connection pool management
        pool_action = pf.Action("ConfigureConnectionPool", pa.py_buffer(b"size:10,timeout:30"))
        
        results = list(server.do_action(context, pool_action))
        assert len(results) == 1
        
        # Verify pool status
        status_action = pf.Action("GetConnectionPoolStatus", pa.py_buffer(b""))
        results = list(server.do_action(context, status_action))
        assert len(results) == 1

    def test_query_result_caching(self, server):
        """Test query result caching for performance."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Enable caching
        cache_action = pf.Action("EnableQueryCache", pa.py_buffer(b"ttl:300"))
        
        results = list(server.do_action(context, cache_action))
        assert len(results) == 1
        
        # Execute same query twice - second should be cached
        ticket = pf.Ticket(b"cached_query")
        
        server.backend.execute_query.return_value = pa.table({
            "cached": [True],
            "timestamp": [time.time()]
        })
        
        stream1 = server.do_get(context, ticket)
        stream2 = server.do_get(context, ticket)
        
        assert isinstance(stream1, pf.FlightDataStream)
        assert isinstance(stream2, pf.FlightDataStream)

    def test_batch_processing_optimization(self, server):
        """Test batch processing for improved throughput."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Configure batch processing
        batch_action = pf.Action("SetBatchSize", pa.py_buffer(b"size:1000"))
        
        results = list(server.do_action(context, batch_action))
        assert len(results) == 1
        
        # Test batched query execution
        ticket = pf.Ticket(b"batch_query")
        
        # Mock batch results
        server.backend.execute_query.return_value = pa.table({
            "batch_id": list(range(10)),
            "batch_size": [1000] * 10
        })
        
        stream = server.do_get(context, ticket)
        assert isinstance(stream, pf.FlightDataStream)

    def test_concurrent_query_limits(self, server):
        """Test concurrent query execution limits."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Set concurrent query limits
        limit_action = pf.Action("SetConcurrentQueryLimit", pa.py_buffer(b"limit:5"))
        
        results = list(server.do_action(context, limit_action))
        assert len(results) == 1
        
        # Test concurrent execution
        tickets = [pf.Ticket(f"concurrent_query_{i}".encode()) for i in range(10)]
        
        server.backend.execute_query.return_value = pa.table({
            "query_id": [1],
            "result": ["concurrent"]
        })
        
        # Should handle concurrent limit gracefully
        streams = []
        for ticket in tickets:
            try:
                stream = server.do_get(context, ticket)
                streams.append(stream)
            except Exception:
                pass  # May hit concurrent limits
        
        # Should have some successful streams
        assert len(streams) >= 1


class TestPhase3Integration:
    """Test Phase 3 methods working together in advanced scenarios."""

    def test_streaming_with_monitoring(self, server):
        """Test streaming query with status monitoring."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Start long-running streaming query
        any_msg = any_pb2.Any()
        any_msg.type_url = FlightSQLProtobuf.COMMAND_STATEMENT_QUERY_TYPE_URL
        query = "SELECT * FROM very_large_table ORDER BY complex_calculation"
        query_encoded = query.encode("utf-8")
        any_msg.value = bytes([0x0A]) + bytes([len(query_encoded)]) + query_encoded
        
        descriptor = pf.FlightDescriptor.for_command(any_msg.SerializeToString())
        ticket = pf.Ticket(any_msg.SerializeToString())
        
        # Get flight info
        server.backend.get_statement_schema.return_value = pa.schema([
            pa.field("id", pa.int64()),
            pa.field("computed_value", pa.float64())
        ])
        
        flight_info = server.get_flight_info(context, descriptor)
        assert isinstance(flight_info, pf.FlightInfo)
        
        # Start streaming
        server.backend.execute_query.return_value = _create_large_test_table(1000)
        stream = server.do_get(context, ticket)
        assert isinstance(stream, pf.FlightDataStream)
        
        # Monitor progress (if poll_flight_info is implemented)
        if hasattr(server, 'poll_flight_info'):
            server.backend.get_query_status.return_value = {
                "status": "running",
                "progress": 0.5
            }
            poll_info = server.poll_flight_info(context, descriptor)
            assert hasattr(poll_info, 'progress')

    def test_transaction_with_cancellation(self, server):
        """Test transaction that can be cancelled mid-execution."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Begin transaction
        with patch('src.mpzsql.flightsql.minimal.ActionBeginTransactionRequest') as mock_begin_req:
            mock_begin_request = Mock()
            mock_begin_req.return_value = mock_begin_request
            
            begin_action = pf.Action("BeginTransaction", pa.py_buffer(b"begin_data"))
            results = list(server.do_action(context, begin_action))
            
            transaction_id = list(server.open_transactions.keys())[0] if server.open_transactions else "txn_1"
        
        # Start long-running operation in transaction
        update_query = "UPDATE large_table SET computed_column = expensive_function(data)"
        
        # Cancel the transaction
        cancel_action = pf.Action("CancelTransaction", pa.py_buffer(transaction_id.encode()))
        cancel_results = list(server.do_action(context, cancel_action))
        assert len(cancel_results) == 1

    def test_session_with_resource_monitoring(self, server):
        """Test session with comprehensive resource monitoring."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Create monitored session
        session_action = pf.Action("CreateMonitoredSession", pa.py_buffer(b"monitoring:enabled"))
        results = list(server.do_action(context, session_action))
        assert len(results) == 1
        
        # Execute operations and monitor resources
        ticket = pf.Ticket(b"resource_intensive_query")
        server.backend.execute_query.return_value = pa.table({
            "result": [1, 2, 3]
        })
        
        stream = server.do_get(context, ticket)
        assert isinstance(stream, pf.FlightDataStream)
        
        # Check resource usage
        resource_action = pf.Action("GetResourceUsage", pa.py_buffer(b""))
        resource_results = list(server.do_action(context, resource_action))
        assert len(resource_results) == 1

    def test_multi_phase_workflow(self, server):
        """Test complex workflow using multiple Phase 3 capabilities."""
        context = Mock(spec=pf.ServerCallContext)
        
        # Phase 1: Setup session and resources
        setup_action = pf.Action("SetupComplexWorkflow", pa.py_buffer(b"workflow:analytics"))
        setup_results = list(server.do_action(context, setup_action))
        assert len(setup_results) == 1
        
        # Phase 2: Start long-running computation with monitoring
        computation_query = "SELECT compute_analytics(data) FROM input_table"
        any_msg = any_pb2.Any()
        any_msg.type_url = FlightSQLProtobuf.COMMAND_STATEMENT_QUERY_TYPE_URL
        query_encoded = computation_query.encode("utf-8")
        any_msg.value = bytes([0x0A]) + bytes([len(query_encoded)]) + query_encoded
        
        descriptor = pf.FlightDescriptor.for_command(any_msg.SerializeToString())
        
        # Phase 3: Monitor and potentially cancel/modify
        if hasattr(server, 'poll_flight_info'):
            server.backend.get_query_status.return_value = {"status": "running", "progress": 0.3}
            poll_info = server.poll_flight_info(context, descriptor)
        
        # Phase 4: Cleanup
        cleanup_action = pf.Action("CleanupWorkflow", pa.py_buffer(b""))
        cleanup_results = list(server.do_action(context, cleanup_action))
        assert len(cleanup_results) == 1
