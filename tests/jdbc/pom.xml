<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.lakehouse</groupId>
    <artifactId>lakehouse-jdbc-tests</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>Lakehouse JDBC Tests</name>
    <description>
        JDBC integration tests for the Lakehouse Flight SQL server.
        Uses Arrow Flight SQL JDBC driver to exercise DDL/DML.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <arrow.version>18.3.0</arrow.version>
        <junit.version>6.0.3</junit.version>
    </properties>

    <dependencies>
        <!-- Arrow Flight SQL JDBC driver -->
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>flight-sql-jdbc-driver</artifactId>
            <version>${arrow.version}</version>
        </dependency>

        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Surefire for JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
                <configuration>
                    <argLine>
                        --add-opens=java.base/java.nio=ALL-UNNAMED
                    </argLine>
                    <systemPropertyVariables>
                        <flight.url>${flight.url}</flight.url>
                        <flight.user>${flight.user}</flight.user>
                        <flight.password>${flight.password}</flight.password>
                        <live.azure.jdbc.required>${live.azure.jdbc.required}</live.azure.jdbc.required>
                        <tls.ca.cert>${tls.ca.cert}</tls.ca.cert>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- exec:java for ad-hoc scripts -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <classpathScope>test</classpathScope>
                    <executable>java</executable>
                    <!-- Required for Apache Arrow on Java 17+ -->
                    <additionalClasspathElements/>
                </configuration>
                <executions>
                    <execution>
                        <id>default-cli</id>
                        <configuration>
                            <toolchain>false</toolchain>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
