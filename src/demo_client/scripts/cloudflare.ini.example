# Cloudflare API credentials for certbot DNS-01 challenge
# Place this file at: ~/.secrets/certbot/cloudflare.ini
# Set permissions: chmod 600 ~/.secrets/certbot/cloudflare.ini

# Option 1: Using Global API Key (legacy method)
# Get your Global API Key from: https://dash.cloudflare.com/profile/api-tokens
# dns_cloudflare_email = your-email@example.com
# dns_cloudflare_api_key = your-global-api-key-here

# Option 2: Using API Token (recommended)
# Create a custom token at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions:
# - Zone:Zone:Read
# - Zone:DNS:Edit
# Include specific zones or all zones as needed
dns_cloudflare_api_token = your-api-token-here

# Notes:
# - Use either email+api_key OR api_token, not both
# - API tokens are more secure as they can be scoped to specific zones
# - Global API keys have full account access (less secure)
# - Ensure this file has restrictive permissions (600)
